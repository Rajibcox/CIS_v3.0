APP_NAME=QUANTUM TRADER V1
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///data/database/quantum.db

# Generate a unique random signing key (at least 32 characters).
# Never commit your real .env file.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Generate an Argon2id hash with:
# python -m src.backend.utils.create_admin
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD_HASH=replace-with-the-generated-argon2id-hash
