APP_NAME=QUANTUM_TRADER_V1
VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///data/database/quantum.db
SECRET_KEY=quantum-trader-secret-key-change-in-production



@"
# Exchange Configuration
EXCHANGE=binance

# API Keys
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Database
DATABASE_URL=sqlite:///data/database/quantum.db

# Application
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Logging
LOG_LEVEL=INFO
"@ | Out-File .env.example -Encoding utf8
